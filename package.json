{
  "name": "dsh-file-mentions",
  "version": "1.1.4",
  "description": "Clickable file paths in DSH replies: open files/directories from inline paths (Codex-style), with a mentioned-files chip list as fallback",
  "type": "module",
  "main": "lib/index.js",
  "scripts": {
    "test": "node --test"
  },
  "exports": {
    ".": "./lib/index.js",
    "./client": "./lib/client.js",
    "./cordis.patch.yml": "./cordis.patch.yml",
    "./package.json": "./package.json"
  },
  "files": [
    "lib",
    "cordis.patch.yml",
    "docs"
  ],
  "keywords": [
    "dsh",
    "deepseek-harness",
    "plugin",
    "file-mentions",
    "clickable-paths",
    "codex",
    "web-ui"
  ],
  "license": "MIT",
  "engines": {
    "dsh": "0.2.1-rc.3",
    "node": ">=24.9.0"
  },
  "repository": {
    "type": "git",
    "url": "https://github.com/Apoze/dsh-file-mentions.git"
  },
  "dsh": {
    "bundle": {
      "patch": "./cordis.patch.yml"
    },
    "client": {
      "inject": [
        "@deepseek-ai/dsh-api-remotes",
        "@deepseek-ai/dsh-client-ui-conversation"
      ],
      "platform": "web"
    }
  },
  "peerDependencies": {
    "@deepseek-ai/cordis": "4.0.5-alpha.2",
    "@deepseek-ai/dsh-settings": "0.2.1-rc.3",
    "@deepseek-ai/schemastery": "3.18.5-alpha.2"
  },
  "devDependencies": {
    "@deepseek-ai/cordis": "4.0.5-alpha.2",
    "@deepseek-ai/dsh-settings": "0.2.1-rc.3",
    "@deepseek-ai/schemastery": "3.18.5-alpha.2"
  }
}
